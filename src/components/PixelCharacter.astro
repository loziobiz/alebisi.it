---
// Componente per il personaggio pixel art
---

<div class="pixel-character">
  <svg width="300" height="400" viewBox="0 0 300 400" style="image-rendering: pixelated;">
    <!-- Bulb -->
    <rect x="110" y="20" width="80" height="20" fill="#FFA500"/>
    <rect x="90" y="40" width="120" height="40" fill="#FFA500"/>
    <rect x="110" y="80" width="80" height="20" fill="#FFA500"/>
    <rect x="130" y="40" width="40" height="40" fill="#FFD700"/>
    
    <!-- Bulb outline -->
    <rect x="90" y="20" width="20" height="20" fill="#000"/>
    <rect x="190" y="20" width="20" height="20" fill="#000"/>
    <rect x="70" y="40" width="20" height="40" fill="#000"/>
    <rect x="210" y="40" width="20" height="40" fill="#000"/>
    <rect x="90" y="80" width="20" height="20" fill="#000"/>
    <rect x="190" y="80" width="20" height="20" fill="#000"/>
    
    <!-- Head -->
    <rect x="90" y="120" width="120" height="80" fill="#FFD700"/>
    <rect x="70" y="140" width="20" height="40" fill="#000"/>
    <rect x="210" y="140" width="20" height="40" fill="#000"/>
    <rect x="90" y="100" width="120" height="20" fill="#000"/>
    <rect x="90" y="200" width="120" height="20" fill="#000"/>
    
    <!-- Eyes -->
    <rect x="110" y="140" width="20" height="20" fill="#000"/>
    <rect x="170" y="140" width="20" height="20" fill="#000"/>
    
    <!-- Smile -->
    <rect x="110" y="180" width="80" height="10" fill="#000"/>
    
    <!-- Body -->
    <rect x="90" y="220" width="120" height="100" fill="#FFD700"/>
    <rect x="70" y="240" width="20" height="60" fill="#000"/>
    <rect x="210" y="240" width="20" height="60" fill="#000"/>
    <rect x="90" y="320" width="120" height="20" fill="#000"/>
    
    <!-- Arms -->
    <rect x="50" y="240" width="40" height="20" fill="#FFD700"/>
    <rect x="210" y="240" width="40" height="20" fill="#FFD700"/>
    <rect x="30" y="240" width="20" height="20" fill="#000"/>
    <rect x="250" y="240" width="20" height="20" fill="#000"/>
    
    <!-- Legs -->
    <rect x="100" y="340" width="40" height="60" fill="#000"/>
    <rect x="160" y="340" width="40" height="60" fill="#000"/>
    
    <!-- Connection lines -->
    <rect x="110" y="100" width="20" height="20" fill="#000"/>
    <rect x="170" y="100" width="20" height="20" fill="#000"/>
  </svg>
</div>

<style>
  .pixel-character {
    width: 300px;
    height: 400px;
    position: relative;
  }

  @media (max-width: 768px) {
    .pixel-character {
      width: 200px;
      height: 267px;
    }

    .pixel-character svg {
      width: 200px;
      height: 267px;
    }
  }
</style>

