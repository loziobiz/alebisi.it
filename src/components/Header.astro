    <a href="#blog">Blog</a>
    <a href="/prj">Developers</a>
    <span class="icon-bulb">💡</span>
  </nav-->
</header>

<style>
  header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 50px;
    border-bottom: 4px solid #000;
    min-height: 30px;
    position: relative;
  }

  .logo {
    font-size: 28px;
    font-weight: bold;
    letter-spacing: 0px;
    font-family: "Press Start 2P", "Courier New", monospace;
    color: #000;
    text-decoration: none;
    transition: transform 0.2s;
    line-height: 1.4;
    min-height: 39px;
    display: inline-block;
    width: auto;
  }

  .logo:hover {
    transform: scale(1.05);
  }

  nav {
    display: flex;
    gap: 40px;
    align-items: center;
  }

  nav a {
    color: #000;
    text-decoration: none;
    font-size: 18px;
    font-weight: bold;
    transition: transform 0.2s;
  }

  nav a:hover {
    transform: scale(1.1);
    text-decoration: underline;
  }

  .icon-bulb {
    font-size: 24px;
    cursor: pointer;
  }

  @media (max-width: 768px) {
    header {
      padding: 15px 20px;
      flex-direction: column;
      gap: 20px;
      min-height: 60px;
    }

    nav {
      gap: 20px;
      flex-wrap: wrap;
      justify-content: center;
    }

    nav a {
      font-size: 14px;
    }

    .logo {
      font-size: 20px;
      line-height: 1.6;
      min-height: auto;
    }
  }

  @media (max-width: 480px) {
    header {
      padding: 12px 15px;
      min-height: 50px;
    }

    .logo {
      font-size: 16px;
      line-height: 1.6;
    }

    nav {
      gap: 15px;
    }

    nav a {
      font-size: 12px;
    }
  }
</style>

